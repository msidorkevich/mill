#!/bin/sh
# Fake herdr for the cli tests. It logs every call (one per line) to herdr.log next to
# itself, answers `tab create` and `tab close` with the responses real herdr printed on
# 2026-11-23 and runs the command of `pane run` in the background.
dir=$(dirname "$0")
echo "$*" >> "$dir/herdr.log"
case "$1 $2" in
'tab create') echo '{"id":"cli:tab:create","result":{"root_pane":{"agent_status":"unknown","cwd":"/private/tmp","focused":false,"foreground_cwd":"/private/tmp","pane_id":"w8:pD8","revision":0,"scroll":{"max_offset_from_bottom":0,"offset_from_bottom":0,"viewport_rows":60},"tab_id":"w8:t2","terminal_id":"term_660f1263366931c0","workspace_id":"w8"},"tab":{"agent_status":"unknown","focused":false,"label":"mill-probe","number":2,"pane_count":1,"tab_id":"w8:t2","workspace_id":"w8"},"type":"tab_created"}}' ;;
'pane run') "$4" "$5" >> "$dir/pane.out" 2>&1 < /dev/null & ;;
'tab close') echo '{"id":"cli:tab:close","result":{"type":"ok"}}' ;;
*) echo "unexpected herdr call: $*" >&2; exit 2 ;;
esac
